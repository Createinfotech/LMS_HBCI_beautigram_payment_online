    <script type="module">
        import {
            getFirestore, doc, getDoc, updateDoc, arrayUnion,
            addDoc, collection, serverTimestamp, query, where, getDocs
        }
            from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        const RAZORPAY_KEY = 'rzp_test_SQGdFwABVjcu3V';

        const params = new URLSearchParams(window.location.search);
        const mode = params.get('mode') || 'enroll';
        const uid = params.get('uid') || params.get('userId') || '';
        const email = params.get('email') || '';
        const phone = params.get('phone') || '';
        const courseId = params.get('courseId') || params.get('id') || '';
        const planIdParam = params.get('planId') || '';
        const isLiveParam = params.get('isLive') === 'true';
        const urlTitle = params.get('title') || params.get('courseTitle') || '';
        const urlPrice = params.get('price') || params.get('amount') || '0';
        const urlThumbnail = params.get('thumbnail') || '';
        const urlPlanName = params.get('planName') || '';
        const urlPlanDuration = parseInt(params.get('duration') || '1');

        let courseData = null;
        let selectedPlan = null;
        let allPlans = [];
        let finalAmount = 0;
        let collectionName = 'courses';

        document.getElementById('uEmail').textContent = email || 'User';
        document.getElementById('uAvatar').textContent = (email || 'U')[0].toUpperCase();

        if (mode === 'subscribe') {
            document.getElementById('pageHeader').className = 'premium';
            document.getElementById('headerIcon').textContent = '👑';
            document.getElementById('headerTitle').textContent = 'Go Premium';
            document.getElementById('headerSubtitle').textContent = 'Unlock unlimited beauty learning';
            document.getElementById('uRole').textContent = 'Subscribing account';
            document.getElementById('loadingText').textContent = 'Loading plans...';
        } else {
            document.getElementById('uRole').textContent = 'Enrolled account';
            document.getElementById('loadingText').textContent = 'Loading course details...';
        }

        async function init() {
            if (!uid) { show('errorDiv'); return; }
            if (mode === 'subscribe') {
                await initSubscribe();
            } else {
                await initEnroll();
            }
        }

        async function initEnroll() {
            if (!courseId) { show('errorDiv'); return; }
            try {
                const db = window._db;
                const { doc, getDoc } = window._fs;

                // Determine collection
                collectionName = isLiveParam ? 'live_courses' : 'courses';
                let courseSnap = await getDoc(doc(db, collectionName, courseId));
                
                // Fallback check: if not found, check the other collection just in case
                if (!courseSnap.exists()) {
                    const otherCol = isLiveParam ? 'courses' : 'live_courses';
                    courseSnap = await getDoc(doc(db, otherCol, courseId));
                    if (courseSnap.exists()) collectionName = otherCol;
                }

                if (!courseSnap.exists()) {
                    // Fallback to URL parameters if Firebase fetch fails
                    if (urlTitle && urlPrice) {
                        courseData = {
                            id: courseId,
                            title: urlTitle,
                            price: parseFloat(urlPrice),
                            imageUrl: urlThumbnail
                        };
                    } else {
                        show('errorDiv'); return; 
                    }
                } else {
                    courseData = { id: courseSnap.id, ...courseSnap.data() };
                }

                const userSnap = await getDoc(doc(db, 'users', uid));
                if (userSnap.exists()) {
                    const list = userSnap.data().enrolledCourses || [];
                    if (list.includes(courseId)) {
                        renderCourse(courseData);
                        document.getElementById('enrollSection').style.display = 'block';
                        document.getElementById('orderCard').style.display = 'none';
                        document.getElementById('payBtn').style.display = 'none';
                        document.querySelector('.secure-note').style.display = 'none';
                        document.getElementById('enrolledCard').style.display = 'block';
                        show('content'); return;
                    }
                }

                renderCourse(courseData);
                document.getElementById('enrollSection').style.display = 'block';
                show('content');

            } catch (e) {
                console.error(e); show('errorDiv');
            }
        }

        function renderCourse(c) {
            document.getElementById('cTitle').textContent = c.title || '';
            document.getElementById('cInstructor').textContent = c.instructor || '';
            document.getElementById('cLessons').textContent = c.totalLessons || '-';
            document.getElementById('cDuration').textContent = c.duration || '-';
            document.getElementById('cRating').textContent = c.rating ? c.rating.toFixed(1) : '-';
            document.getElementById('cDesc').textContent = c.description || '';

            if (c.imageUrl) {
                document.getElementById('imgWrap').innerHTML =
                    `<img src="${c.imageUrl}" alt="${c.title}" onerror="this.parentNode.innerHTML='🎓'"/>`;
            }

            const price = c.price || 0;
            const gst = Math.round(price * 0.18);
            finalAmount = price + gst;

            document.getElementById('oName').textContent = c.title || '';
            document.getElementById('oPrice').textContent = `₹${price}`;
            document.getElementById('oGst').textContent = `₹${gst}`;
            document.getElementById('oTotal').textContent = `₹${finalAmount}`;
            document.getElementById('payBtn').textContent = `💳 Pay ₹${finalAmount} & Enroll`;
        }

        async function initSubscribe() {
            try {
                const db = window._db;
                const { doc, getDoc } = window._fs;

                const userSnap = await getDoc(doc(db, 'users', uid));
                if (userSnap.exists()) {
                    const data = userSnap.data();
                    if (data.isPremium === true) {
                        const expiry = data.premiumExpiry?.toDate?.();
                        if (expiry) {
                            document.getElementById('premiumExpiry').textContent =
                                `Expires: ${expiry.getDate()}/${expiry.getMonth() + 1}/${expiry.getFullYear()}`;
                        }
                        document.getElementById('alreadyPremium').style.display = 'block';
                        document.getElementById('planSection').style.display = 'none';
                        document.getElementById('orderCard').style.display = 'none';
                        document.getElementById('payBtn').style.display = 'none';
                        document.querySelector('.secure-note').style.display = 'none';
                        document.getElementById('subscribeSection').style.display = 'block';
                        show('content'); return;
                    }
                }

                await loadPlans();
                document.getElementById('subscribeSection').style.display = 'block';
                show('content');

            } catch (e) {
                console.error(e); show('errorDiv');
            }
        }

        async function loadPlans() {
            try {
                const db = window._db;
                const { collection, query, where, getDocs } = window._fs;

                const q = query(collection(db, 'subscription_plans'), where('isActive', '==', true));
                const snap = await getDocs(q);

                if (!snap.empty) {
                    allPlans = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                    allPlans.sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0));
                } else {
                    allPlans = [
                        { id: 'monthly', name: '1 Month', description: 'Monthly plan', price: 299, originalPrice: 399, durationMonths: 1, isPopular: false, durationText: '1 Month', pricePerMonth: '₹299/mo' },
                        { id: 'quarterly', name: '3 Months', description: 'Most popular plan', price: 799, originalPrice: 1197, durationMonths: 3, isPopular: true, durationText: '3 Months', pricePerMonth: '₹266/mo' },
                        { id: 'yearly', name: '12 Months', description: 'Best value plan', price: 2499, originalPrice: 4788, durationMonths: 12, isPopular: false, durationText: '12 Months', pricePerMonth: '₹208/mo' },
                    ];
                }

                // If URL provides a specific plan that is not in the list, add it dynamically
                if (planIdParam && !allPlans.some(p => p.id === planIdParam)) {
                    if (urlPlanName && parseFloat(urlPrice) > 0) {
                        allPlans.push({
                            id: planIdParam,
                            name: urlPlanName,
                            description: 'Selected Plan',
                            price: parseFloat(urlPrice),
                            durationMonths: urlPlanDuration,
                            durationText: urlPlanDuration + (urlPlanDuration > 1 ? ' Months' : ' Month'),
                            isPopular: true
                        });
                    }
                }

                renderPlans();

                const auto = allPlans.find(p => p.id === planIdParam)
                    || allPlans.find(p => p.isPopular)
                    || allPlans[0];
                if (auto) selectPlan(auto);

            } catch (e) {
                console.error('Plan load error:', e);
            }
        }

        function renderPlans() {
            const container = document.getElementById('plansList');
            container.innerHTML = '';

            // If planId passed in URL, show ONLY that plan
            const plansToShow = planIdParam
                ? allPlans.filter(p => p.id === planIdParam)
                : allPlans;

            // If planId not found, fallback to all plans
            const finalPlans = plansToShow.length > 0 ? plansToShow : allPlans;

            finalPlans.forEach(plan => {
                const discount = plan.originalPrice && plan.originalPrice > plan.price
                    ? `Save ${Math.round((1 - plan.price / plan.originalPrice) * 100)}%` : null;

                const card = document.createElement('div');
                // If only 1 plan, auto-select it and hide radio
                const isSingle = finalPlans.length === 1;
                card.className = `plan-card${(plan.isPopular || isSingle) ? ' selected' : ''}`;
                card.id = `plan-${plan.id}`;
                if (!isSingle) card.onclick = () => selectPlan(plan);
                card.innerHTML = `
        ${plan.isPopular && !isSingle ? '<div class="popular-badge">⭐ POPULAR</div>' : ''}
        <div class="plan-row">
          ${!isSingle ? '<div class="radio-circle"><div class="radio-dot"></div></div>' : ''}
          <div class="plan-info">
            <div class="plan-name">${plan.name}</div>
            <div class="plan-desc">${plan.description || ''}</div>
          </div>
          <div class="plan-price-col">
            ${plan.originalPrice && plan.originalPrice > plan.price
                        ? `<div class="orig-price">₹${plan.originalPrice}</div>` : ''}
            <div class="curr-price">₹${plan.price}</div>
            <div class="plan-dur">${plan.durationText || ''}</div>
          </div>
        </div>
        ${discount || (plan.durationMonths > 1 && plan.pricePerMonth)
                        ? `<div style="margin-top:6px">
              ${discount ? `<span class="discount-badge">🎉 ${discount}</span>` : ''}
              ${plan.durationMonths > 1 && plan.pricePerMonth
                            ? `<span style="font-size:0.75rem;color:#888;margin-left:8px">${plan.pricePerMonth}</span>` : ''}
             </div>` : ''}
      `;
                container.appendChild(card);
            });
        }

        function selectPlan(plan) {
            selectedPlan = plan;
            document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('selected'));
            const card = document.getElementById(`plan-${plan.id}`);
            if (card) card.classList.add('selected');

            const p = plan.price || 0;
            const gst = Math.round(p * 0.18);
            finalAmount = p + gst;

            document.getElementById('oName').textContent = plan.name;
            document.getElementById('oPrice').textContent = `₹${p}`;
            document.getElementById('oGst').textContent = `₹${gst}`;
            document.getElementById('oTotal').textContent = `₹${finalAmount}`;
            document.getElementById('payBtn').textContent =
                `👑 Subscribe ₹${finalAmount} · ${plan.durationText || ''}`;
        }

        window.startPayment = function () {
            const isSubscribe = mode === 'subscribe';
            const desc = isSubscribe
                ? `${selectedPlan?.name} Subscription`
                : courseData?.title || 'Course Purchase';

            const options = {
                key: RAZORPAY_KEY,
                amount: finalAmount * 100,
                currency: 'INR',
                name: 'Beautygram',
                description: desc,
                image: 'https://beautygram.in/logo.png',
                prefill: { email, contact: phone, name: email.split('@')[0] },
                theme: { color: '#c0396b' },
                handler: async function (response) {
                    isSubscribe
                        ? await onSubscribeSuccess(response)
                        : await onEnrollSuccess(response);
                },
                modal: { ondismiss: function () { } },
            };

            const rzp = new Razorpay(options);
            rzp.on('payment.failed', r => alert('Payment failed: ' + r.error.description));
            rzp.open();
        };

        async function onEnrollSuccess(response) {
            const btn = document.getElementById('payBtn');
            btn.disabled = true;
            btn.textContent = '⏳ Enrollment processing...';

            try {
                const db = window._db;
                const { doc, updateDoc, arrayUnion, addDoc, collection, serverTimestamp } = window._fs;

                await updateDoc(doc(db, 'users', uid), {
                    enrolledCourses: arrayUnion(courseId)
                });

                await addDoc(collection(db, 'purchases'), {
                    uid, courseId,
                    courseTitle: courseData.title,
                    amount: finalAmount,
                    razorpayPaymentId: response.razorpay_payment_id,
                    email, purchasedAt: serverTimestamp(), status: 'success',
                    collectionName: collectionName // Record whether it was live or normal
                });

                // Update count if course exists in Firebase
                try {
                    await updateDoc(doc(db, collectionName, courseId), {
                        enrolledCount: (courseData.enrolledCount || 0) + 1
                    });
                } catch(err) {
                    console.log("Could not update enrolledCount (might be using URL fallback)");
                }

                document.getElementById('successIcon').textContent = '🎉';
                document.getElementById('successTitle').textContent = 'Enrollment Successful!';
                document.getElementById('successMsg').textContent =
                    'Course unlock થઈ ગઈ! App open કરો અને શીખવાનું શરૂ કરો.';
                show('successDiv');

            } catch (e) {
                console.error(e);
                alert('Payment done! App refresh karo. Issue: ramdev3694@gmail.com');
                show('successDiv');
            }
        }

        async function onSubscribeSuccess(response) {
            const btn = document.getElementById('payBtn');
            btn.disabled = true;
            btn.textContent = '⏳ Activating subscription...';

            try {
                const db = window._db;
                const { doc, updateDoc, addDoc, collection, serverTimestamp } = window._fs;

                const now = new Date();
                const expiry = new Date(now);
                expiry.setMonth(expiry.getMonth() + (selectedPlan.durationMonths || 1));

                await updateDoc(doc(db, 'users', uid), {
                    isPremium: true,
                    activePlanId: selectedPlan.id,
                    activePlanName: selectedPlan.name,
                    premiumExpiry: expiry,
                    premiumStartDate: now,
                });

                await addDoc(collection(db, 'subscriptions'), {
                    uid, planId: selectedPlan.id, planName: selectedPlan.name,
                    amount: finalAmount, durationMonths: selectedPlan.durationMonths || 1,
                    razorpayPaymentId: response.razorpay_payment_id,
                    email, startDate: now, expiryDate: expiry,
                    subscribedAt: serverTimestamp(), status: 'active'
                });

                document.getElementById('successIcon').textContent = '👑';
                document.getElementById('successTitle').textContent = "You're Premium!";
                document.getElementById('successMsg').textContent =
                    `${selectedPlan.name} activate થઈ ગઈ! App open કરો અને enjoy કરો.`;
                show('successDiv');

            } catch (e) {
                console.error(e);
                alert('Payment done! App refresh karo. Issue: ramdev3694@gmail.com');
                show('successDiv');
            }
        }

        window.openApp = function () {
            window.location.href = mode === 'subscribe'
                ? 'beautygram://premium'
                : 'beautygram://courses';
            setTimeout(() => {
                window.location.href =
                    'https://play.google.com/store/apps/details?id=com.hbci.Beautygram';
            }, 2000);
        };

        function show(id) {
            document.getElementById('loading').style.display = 'none';
            ['errorDiv', 'successDiv', 'content'].forEach(i => {
                const el = document.getElementById(i);
                if (el) el.style.display = (i === id ? 'block' : 'none');
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        const wait = setInterval(() => {
            if (window._firebaseReady) { clearInterval(wait); init(); }
        }, 100);
    </script>

</body>

